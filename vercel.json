{
  "headers": [
    {
      "source": "/friend-articles.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "cleanUrls": true
}